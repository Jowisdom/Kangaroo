{
  "name": "textbundle-editor",
  "version": "1.0.0",
  "description": "Kangaroo is a local TextBundle editor for Markdown, attachments, and preview-based writing.",
  "homepage": "https://example.com/kangaroo",
  "author": {
    "name": "Wisdom",
    "email": "wisdom@example.com"
  },
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:linux": "electron-builder --linux AppImage deb --arm64 --x64"
  },
  "build": {
    "appId": "com.yourname.kangaroo",
    "productName": "Kangaroo",
    "icon": "build/icon.png",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "wysiwyg-editor.js",
      "index.html",
      "package.json",
      "build/**/*",
      "theme-assets/**/*",
      "node_modules/**/*",
      "!dist{,/**}",
      "!.git{,/**}",
      "!.idea{,/**}"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Wisdom <wisdom@example.com>",
      "mimeTypes": [
        "application/x-textbundle"
      ],
      "desktop": {
        "entry": {
          "MimeType": "application/x-textbundle;"
        }
      }
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "TextBundle Document",
            "CFBundleTypeExtensions": [
              "textbundle"
            ],
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSTypeIsPackage": true
          }
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": "textbundle",
        "name": "TextBundle Document",
        "role": "Editor",
        "description": "Kangaroo TextBundle Document",
        "mimeType": "application/x-textbundle",
        "isPackage": true,
        "rank": "Owner"
      }
    ]
  },
  "devDependencies": {
    "electron": "^41.0.4",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@tiptap/core": "^3.21.0",
    "@tiptap/extension-image": "^3.21.0",
    "@tiptap/extension-list": "^3.21.0",
    "@tiptap/extension-underline": "^3.21.0",
    "@tiptap/markdown": "^3.21.0",
    "@tiptap/pm": "^3.21.0",
    "@tiptap/starter-kit": "^3.21.0",
    "markdown-it": "^14.1.1"
  }
}
