{
  "name": "kangaroo",
  "version": "1.0.3",
  "description": "Kangaroo is a local bundle editor for Markdown, attachments, and preview-based writing.",
  "homepage": "https://example.com/kangaroo",
  "author": {
    "name": "Wisdom",
    "email": "wisdom@example.com"
  },
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "predist": "node scripts/build-mac-clipboard-helper.js",
    "predist:app": "node scripts/build-mac-clipboard-helper.js",
    "predist:mac": "node scripts/build-mac-clipboard-helper.js",
    "start": "electron .",
    "dist": "electron-builder",
    "dist:app": "electron-builder --dir",
    "dist:mac": "electron-builder --mac --x64 --arm64",
    "dist:mac:x64": "electron-builder --mac --x64",
    "dist:mac:arm64": "electron-builder --mac --arm64",
    "dist:win": "electron-builder --win --x64 --arm64",
    "dist:win:x64": "electron-builder --win --x64",
    "dist:win:arm64": "electron-builder --win --arm64",
    "dist:linux": "electron-builder --linux AppImage deb --arm64 --x64",
    "dist:linux:x64": "electron-builder --linux AppImage deb --x64",
    "dist:linux:arm64": "electron-builder --linux AppImage deb --arm64"
  },
  "build": {
    "appId": "com.yourname.kangaroo",
    "productName": "Kangaroo",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.png",
    "compression": "maximum",
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "renderer.js",
      "wysiwyg-editor.js",
      "index.html",
      "package.json",
      "assets/fonts/maple-mono-normalnl/**/*",
      "build/**/*",
      "theme-assets/**/*",
      "node_modules/**/*",
      "scripts/build-mac-clipboard-helper.js",
      "!node_modules/@fontsource/lxgw-wenkai/**",
      "!node_modules/@fontsource/long-cang/**",
      "!node_modules/@fontsource/m-plus-rounded-1c/**",
      "!node_modules/@fontsource/noto-sans-sc/**",
      "!node_modules/@fontsource/noto-serif-sc/**",
      "!node_modules/@fontsource/zcool-qingke-huangyou/**",
      "!node_modules/@fontsource/zcool-xiaowei/**",
      "!node_modules/@fortawesome/fontawesome-free/js/**",
      "!node_modules/@fortawesome/fontawesome-free/metadata/**",
      "!node_modules/@fortawesome/fontawesome-free/scss/**",
      "!node_modules/@fortawesome/fontawesome-free/sprites/**",
      "!node_modules/@fortawesome/fontawesome-free/sprites-full/**",
      "!node_modules/@fortawesome/fontawesome-free/svgs/**",
      "!node_modules/@fortawesome/fontawesome-free/svgs-full/**",
      "!node_modules/**/{test,tests,__tests__,powered-test,docs,doc,example,examples,.github,.vscode}/**",
      "!node_modules/**/*.map",
      "!node_modules/**/*.ts",
      "!node_modules/**/*.tsx",
      "!node_modules/**/*.coffee",
      "!node_modules/**/src/**",
      "!node_modules/**/coverage/**",
      "!node_modules/**/benchmark{,s}/**",
      "!node_modules/**/bench{,s}/**",
      "!dist{,/**}",
      "!.git{,/**}",
      "!.idea{,/**}"
    ],
    "extraResources": [
      {
        "from": "build/copy-file-to-clipboard",
        "to": "copy-file-to-clipboard"
      },
      {
        "from": "build/copy-file-to-clipboard.app",
        "to": "copy-file-to-clipboard.app"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "maintainer": "Wisdom <wisdom@example.com>",
      "mimeTypes": [
        "application/x-kangaroo",
        "application/x-textbundle"
      ],
      "desktop": {
        "entry": {
          "MimeType": "application/x-kangaroo;application/x-textbundle;"
        }
      }
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.productivity",
      "extendInfo": {
        "CFBundleDocumentTypes": [
          {
            "CFBundleTypeName": "Kangaroo Document",
            "CFBundleTypeExtensions": [
              "kangaroo",
              "textbundle"
            ],
            "CFBundleTypeRole": "Editor",
            "LSHandlerRank": "Owner",
            "LSTypeIsPackage": true
          }
        ]
      }
    },
    "fileAssociations": [
      {
        "ext": "kangaroo",
        "name": "Kangaroo Document",
        "role": "Editor",
        "description": "Kangaroo Document",
        "mimeType": "application/x-kangaroo",
        "isPackage": true,
        "rank": "Owner"
      },
      {
        "ext": "textbundle",
        "name": "TextBundle Document",
        "role": "Editor",
        "description": "Legacy Kangaroo TextBundle Document",
        "mimeType": "application/x-textbundle",
        "isPackage": true,
        "rank": "Owner"
      }
    ]
  },
  "devDependencies": {
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1"
  },
  "dependencies": {
    "@fontsource/fira-code": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@fontsource/libre-baskerville": "^5.2.10",
    "@fontsource/long-cang": "^5.2.8",
    "@fontsource/lxgw-wenkai": "^5.2.5",
    "@fontsource/m-plus-rounded-1c": "^5.2.10",
    "@fontsource/noto-sans-sc": "^5.2.9",
    "@fontsource/noto-serif-sc": "^5.2.9",
    "@fontsource/zcool-qingke-huangyou": "^5.2.8",
    "@fontsource/zcool-xiaowei": "^5.2.8",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@tiptap/core": "^3.21.0",
    "@tiptap/extension-image": "^3.21.0",
    "@tiptap/extension-list": "^3.21.0",
    "@tiptap/extension-underline": "^3.21.0",
    "@tiptap/markdown": "^3.21.0",
    "@tiptap/pm": "^3.21.0",
    "@tiptap/starter-kit": "^3.21.0",
    "markdown-it": "^14.1.1"
  }
}
